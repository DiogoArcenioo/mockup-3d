PGHOST=your-postgres-host
PGPORT=5432
PGDATABASE=infinity-db
PGUSER=admin
PGPASSWORD=your-database-password
PGSSLMODE=disable
API_HOST=127.0.0.1
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
APP_ORIGIN=http://localhost:5173
WEB_PORT=5173
# Initial admin only. Remove ADMIN_PASSWORD after the first successful startup.
ADMIN_NAME=Diogo
ADMIN_LOGIN=diogo
ADMIN_PASSWORD=
# Use true behind an HTTPS reverse proxy in production.
COOKIE_SECURE=false
