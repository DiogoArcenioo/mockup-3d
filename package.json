{
  "name": "infinity-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:studio": "vite --host 127.0.0.1",
    "start": "node scripts/start.mjs",
    "dev:api": "npm run build:api && node --env-file-if-exists=.env --watch apps/api/dist/main.js",
    "dev:web": "next dev apps/web --hostname 0.0.0.0 --port 5173",
    "db:migrate": "npm run build:api && node --env-file-if-exists=.env apps/api/dist/migrate.js",
    "test:auth": "node --env-file-if-exists=.env --test tests/auth.integration.mjs",
    "test:password": "node --env-file-if-exists=.env --test tests/password-settings.integration.mjs",
    "test:web": "node --env-file-if-exists=.env --test tests/auth-web.integration.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:finance": "node --env-file-if-exists=.env --test tests/cashbook.integration.mjs",
    "test:browser": "node --env-file-if-exists=.env scripts/check-finance-browser.mjs",
    "build:legacy": "tsc --noEmit && vite build && node scripts/build-pwa.mjs",
    "build:api": "node scripts/build-api.mjs",
    "build:web": "next build apps/web",
    "build": "npm run build:legacy && npm run build:api && npm run build:web",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
